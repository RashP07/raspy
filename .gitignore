# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.vinext/
work/
/.wrangler/
/tmp/

# Alternate package manager lockfile; this project tracks package-lock.json
bun.lock

# Deploy and provider config — carries project ids, account ids, or secrets.
# Keep these local; a public repo should build without them.
.openai/
.netlify
.dev.vars
.dev.vars.*
wrangler.local.toml

# Credentials and keys. *.pem is already covered above.
*.key
*.p8
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_ed25519
*.der
credentials.json
service-account*.json
gha-creds-*.json
secrets.json
secrets.*.json
*.secret
.npmrc
.yarnrc.yml
.netrc

# Editor and OS noise
.idea/
*.swp
*.swo
Thumbs.db
